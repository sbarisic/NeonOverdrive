<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SelfContained>true</SelfContained>
    <WasmMainJSPath>Web/main.js</WasmMainJSPath>
    <WasmBuildNative>true</WasmBuildNative>
    <WasmAllowUndefinedSymbols>true</WasmAllowUndefinedSymbols>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EmccFlags>$(EmccFlags) -sALLOW_MEMORY_GROWTH=1 -sINITIAL_MEMORY=64MB</EmccFlags>
    <EmccLinkOptimizationFlag>-O0</EmccLinkOptimizationFlag>
    <EmccCompileOptimizationFlag>-O0</EmccCompileOptimizationFlag>
    <WasmNativeStrip>false</WasmNativeStrip>
    <WasmEmitSymbolMap>false</WasmEmitSymbolMap>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource
      Include="Fonts/Rajdhani-SemiBold.ttf"
      LogicalName="NeonOverdrive.Rajdhani.ttf"
    />
    <WasmExtraFilesToDeploy Include="Fonts/OFL.txt" TargetPath="fonts/OFL.txt" />
    <PackageReference Include="Raylib-cs" Version="8.1.0" />
    <ProjectReference Include="../../ArcadeDodger.Multiplayer/ArcadeDodger.Multiplayer.csproj" />
    <!-- Deploy every browser module; BrowserAssets fingerprints the same module graph. -->
    <WasmExtraFilesToDeploy Include="Web/*.js" TargetPath="%(Filename)%(Extension)" />
    <WasmExtraFilesToDeploy Include="Web/index.html" TargetPath="index.html" />
  </ItemGroup>
</Project>
