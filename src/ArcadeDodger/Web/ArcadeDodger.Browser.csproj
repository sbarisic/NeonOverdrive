<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SelfContained>true</SelfContained>
    <WasmMainJSPath>Web/main.js</WasmMainJSPath>
    <WasmBuildNative>true</WasmBuildNative>
    <WasmAllowUndefinedSymbols>true</WasmAllowUndefinedSymbols>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EmccFlags>$(EmccFlags) -sALLOW_MEMORY_GROWTH=1 -sINITIAL_MEMORY=64MB</EmccFlags>
    <EmccLinkOptimizationFlag>-O0</EmccLinkOptimizationFlag>
    <EmccCompileOptimizationFlag>-O0</EmccCompileOptimizationFlag>
    <WasmNativeStrip>false</WasmNativeStrip>
    <WasmEmitSymbolMap>false</WasmEmitSymbolMap>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Raylib-cs" Version="8.1.0" />
    <ProjectReference Include="../../ArcadeDodger.Multiplayer/ArcadeDodger.Multiplayer.csproj" />
    <WasmExtraFilesToDeploy Include="Web/index.html" TargetPath="index.html" />
    <WasmExtraFilesToDeploy Include="Web/main.js" TargetPath="main.js" />
    <WasmExtraFilesToDeploy Include="Web/snapshot.js" TargetPath="snapshot.js" />
    <WasmExtraFilesToDeploy Include="Web/sector.js" TargetPath="sector.js" />
    <WasmExtraFilesToDeploy Include="Web/network.js" TargetPath="network.js" />
    <WasmExtraFilesToDeploy Include="Web/weapons.js" TargetPath="weapons.js" />
    <WasmExtraFilesToDeploy Include="Web/friends.js" TargetPath="friends.js" />
    <WasmExtraFilesToDeploy Include="Web/audio.js" TargetPath="audio.js" />
    <WasmExtraFilesToDeploy Include="Web/skills.js" TargetPath="skills.js" />
    <WasmExtraFilesToDeploy Include="Web/skill-definitions.js" TargetPath="skill-definitions.js" />
  </ItemGroup>
</Project>
